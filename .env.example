# ============================================================
#  Environment template - Dairy CIP Digital Twin
#  ----------------------------------------------------------
#  Copy this file to ".env" and fill in your own values.
#  This template holds PLACEHOLDERS ONLY: no real secrets and no
#  machine-specific or personal filesystem paths are stored here.
#  NEVER commit your private ".env" (it is git-ignored).
#
#  Configuration precedence (lowest -> highest):
#      built-in defaults  <  .env  <  session setenv()
# ============================================================

# --- Generative-AI decision-support layer (OPTIONAL) ----------------
#  The Gemini layer is optional. With no key the pipeline runs in the
#  Deterministic Offline Reproduction Mode (see README) and remains fully
#  reproducible offline. Canonical or Vite-style names are accepted;
#  src/load_dotenv.m maps VITE_* to the canonical names.
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
# VITE_GEMINI_API_KEY=your-google-gemini-api-key-here
# VITE_GEMINI_MODEL=gemini-3.5-flash

# --- Reproduction mode: auto (default) | mock | live ----------------
#   mock - Deterministic Offline Reproduction Mode: no network, no key,
#          fully reproducible (recommended for peer review and CI).
#   auto - attempt live if a key is set; otherwise fall back to mock.
#   live - require a live call (still mock-safe if the key is missing).
# A session setenv('CIP_GEMINI_MODE','mock') always wins over this file.
# CIP_GEMINI_MODE=mock

# --- Study size: number of Monte-Carlo scenarios --------------------
#   Built-in default is 5000 (canonical). Uncomment only to override,
#   e.g. 50 for a quick smoke test.
# CIP_N_SCENARIOS=5000

# --- Optimization knobs (defaults shown; uncomment to override) -----
# CIP_FIX_SOIL0=true
# CIP_GA_POP=200
# CIP_GA_MAXGEN=150

# --- Closed-loop / innovation pipeline ------------------------------
# Number of AI closed-loop iterations (default 3):
# CIP_CLOSED_LOOP_ITERS=3
# Skip the (slow) closed-loop study inside run_innovation_pipeline.m?
#   0 = run the full closed-loop (default); 1 = fast dev path (skip).
# CIP_INNOVATION_SKIP_CLOSED_LOOP=0

# --- Optional overrides (portable only; never store a personal path) -
# Python interpreter for figure/table regeneration (name on PATH):
# CIP_PYTHON_CMD=python
# Simulink Agentic Toolkit location, only if installed somewhere other
# than the portable default <user home>/.matlab/agentic-toolkits/simulink:
# CIP_SATK_PATH=
